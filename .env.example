# TEMPLATE ONLY. Replace every placeholder locally before starting future services.
# The backend reads exported settings, not this file automatically. Future settings are labeled below.

# Local runtime; intended defaults are documented, not real values here.
APP_ENV=<development-or-production>
LOG_LEVEL=<INFO>
WEB_ORIGIN=<http://localhost:3000>
API_PUBLIC_URL=<http://localhost:8000>

# Compose database credentials must match DATABASE_URL.
POSTGRES_DB=<local-database-name>
POSTGRES_USER=<local-database-user>
POSTGRES_PASSWORD=<generate-a-local-database-password>
DATABASE_URL=<postgresql+psycopg://user:password@postgres:5432/database>

# Phase 2 local database and DEVELOPMENT-ONLY read API access; see the backend runbook.
# Optional Compose-only shell setting SHRIKE_LOCAL_DB_PORT defaults to 55432.
SHRIKE_LOCAL_DB_PASSWORD=<generate-and-export-a-local-compose-database-password>
ENABLE_DEV_AUTH=<false>
DEV_AUTH_TOKEN=<generate-a-random-32-to-512-character-development-token>
DEV_REPOSITORY_GRANTS=<installation-github-id:repository-github-id-pairs-separated-by-commas>

# Future phases: Redis is a private broker; PostgreSQL will store durable job state.
REDIS_PASSWORD=<generate-a-local-redis-password>
CELERY_BROKER_URL=<redis://:password@redis:6379/0>

# Future session/OAuth phases: key encoding will be pinned before use.
SESSION_SECRET=<generate-a-random-session-signing-secret>
TOKEN_ENCRYPTION_KEY=<generate-a-local-token-encryption-key>

# Phase 3: real GitHub integration is opt-in; tests inject mocked adapters/transports.
GITHUB_MODE=<disabled>
GITHUB_WEBHOOKS_ENABLED=<false>
GITHUB_APP_ID=<github-app-id>
GITHUB_APP_CLIENT_ID=<optional-public-github-app-client-id-for-jwt-issuer>
GITHUB_APP_SLUG=<github-app-slug>
GITHUB_APP_PRIVATE_KEY_PATH=<absolute-read-only-mounted-pem-path>
GITHUB_WEBHOOK_SECRET=<generate-a-random-webhook-secret>
# Future user-login phase; these OAuth settings are not required by the Phase 3 App worker.
GITHUB_OAUTH_CLIENT_ID=<github-app-client-id>
GITHUB_OAUTH_CLIENT_SECRET=<github-app-client-secret>
GITHUB_OAUTH_CALLBACK_URL=<http://localhost:8000/auth/github/callback>

# Mock mode is the planned local default; no real provider key is needed.
LLM_PROVIDER=<mock>
LLM_MODEL=<mock-v1>
LLM_API_BASE_URL=<optional-approved-provider-https-url>
LLM_API_KEY=<optional-provider-key-leave-unset-in-mock-mode>
LLM_ALLOW_PRIVATE_CODE=<false>

# Proposed application limits; units are explicit.
WEBHOOK_MAX_BYTES=<1048576>
REVIEW_MAX_DIFF_BYTES=<524288>
REVIEW_MAX_FILES=<20>
REVIEW_MAX_FILE_BYTES=<204800>
REVIEW_MAX_CHANGED_LINES=<2000>
REVIEW_MAX_INLINE_COMMENTS=<10>
REVIEW_MAX_LLM_INPUT_TOKENS=<12000>
REVIEW_MAX_LLM_OUTPUT_TOKENS=<2000>
REVIEW_TIMEOUT_SECONDS=<180>
REVIEW_MAX_ATTEMPTS=<3>
REVIEW_RETENTION_DAYS=<30>
